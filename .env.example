# Environment variables — copy to .env and fill in values
# NEVER commit .env to version control

# ─── Kaggle ───────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_intel
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=change_me_strong_password

# ─── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ecommerce_intelligence

# ─── Paths ────────────────────────────────────────────────────
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_SYNTHETIC_PATH=data/synthetic
MODELS_PATH=models/saved

# ─── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_to_a_random_secret_key

# ─── Dashboard ────────────────────────────────────────────────
DASHBOARD_PORT=8501

# ─── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
